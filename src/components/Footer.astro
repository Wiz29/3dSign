---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-light-surface)] border-t border-gray-200 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div class="md:col-span-2">
        <a href="/" class="text-2xl font-heading font-bold text-gray-900 text-glow animate-flicker mb-4 block">
          Classic<span class="text-neon-pink text-glow-pink animate-flicker-pink">Printing</span>
        </a>
        <p class="text-gray-600 mt-4 max-w-sm">
          Premium glowing sign boards, 3D signs, flex printing, and acrylic solutions that make your business stand out in the dark.
        </p>
      </div>
      <div>
        <h3 class="text-lg font-heading font-semibold text-gray-900 mb-4">Quick Links</h3>
        <ul class="space-y-2">
          <li><a href="/about" class="text-gray-600 hover:text-neon-blue transition-colors">About Us</a></li>
          <li><a href="/services" class="text-gray-600 hover:text-neon-blue transition-colors">Services</a></li>
          <li><a href="/catalog" class="text-gray-600 hover:text-neon-blue transition-colors">Catalog</a></li>
          <li><a href="/blog" class="text-gray-600 hover:text-neon-blue transition-colors">Blog</a></li>
          <li><a href="/contact" class="text-gray-600 hover:text-neon-blue transition-colors">Contact Us</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-lg font-heading font-semibold text-gray-900 mb-4">Contact</h3>
        <ul class="space-y-2 text-gray-600">
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-neon-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            +91 7976169388
          </li>
          <li class="flex items-center gap-2">
            <svg class="w-5 h-5 text-neon-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
            WhatsApp: 7976169388
          </li>
          <li class="flex items-center gap-2 mt-4">
            <svg class="w-5 h-5 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            rbishnoi.me@gmail.com
          </li>
        </ul>
      </div>
    </div>
    <div class="border-t border-gray-200 mt-12 pt-8 text-center text-gray-500 text-sm">
      <p>&copy; {currentYear} Classic Printing. All rights reserved.</p>
    </div>
  </div>
</footer>
