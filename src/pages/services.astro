---
import Layout from '../layouts/Layout.astro';

const schemas = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Sign Board Manufacturing and Printing",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Classic Printing",
      "telephone": "+917976169388",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Chandigarh",
        "addressRegion": "Chandigarh",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 30.7333,
        "longitude": 76.7794
      }
    },
    "areaServed": [
      { "@type": "City", "name": "Chandigarh" },
      { "@type": "City", "name": "Mohali" },
      { "@type": "City", "name": "Kharar" },
      { "@type": "City", "name": "Kurali" },
      { "@type": "City", "name": "Zirakpur" },
      { "@type": "City", "name": "Panchkula" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Sign Board Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Glow Sign Boards" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "3D Sign Boards" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Flex Sign Boards" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Acrylic Printing & Boards" } }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is the cost of a glow sign board in Chandigarh?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The cost of a glow sign board in Chandigarh varies based on size, design complexity, and LED type. Classic Printing offers competitive pricing starting from affordable rates. Contact us at 7976169388 for a free custom quote."
        }
      },
      {
        "@type": "Question",
        "name": "Do you provide 3D sign board installation in Mohali and Zirakpur?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, Classic Printing provides end-to-end 3D sign board services including design, manufacturing, and professional installation across Mohali, Zirakpur, Panchkula, Kharar, Kurali, and all of Chandigarh."
        }
      },
      {
        "@type": "Question",
        "name": "How long does flex printing take?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Standard flex printing orders are typically completed within 24-48 hours. For urgent requirements in the Tricity area, same-day delivery is available. Call 7976169388 for rush orders."
        }
      }
    ]
  }
]);
---

<Layout 
  title="Glow Signs, 3D Signs & Flex Printing Services"
  description="Expert glow sign boards, 3D sign boards, flex printing & acrylic board services in Chandigarh, Mohali, Zirakpur, Panchkula, Kharar & Kurali. Call 7976169388!"
  schema={schemas}
  canonicalPath="/services"
>
  <div class="pt-32 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-20">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 text-glow-pink animate-flicker-pink mb-4">Our Services</h1>
      <div class="h-1 w-24 bg-neon-pink mx-auto box-glow"></div>
      <p class="mt-6 text-xl text-gray-600 max-w-2xl mx-auto">
        Comprehensive printing and signage solutions tailored for businesses in <strong>Chandigarh, Mohali, Kharar, Kurali, Zirakpur, and Panchkula</strong>.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      {[
        { 
          title: 'Signage & Boards', 
          desc: 'Premium 3D letters, acrylic signs, glowing LED boards, and trendy neon signs for corporate offices and retail storefronts.',
          icon: 'M13 10V3L4 14h7v7l9-11h-7z',
          color: 'text-neon-blue',
          link: '/catalog'
        },
        { 
          title: 'Printing & Flex', 
          desc: 'High-resolution flex banners, vinyl prints, UV flatbed printing, and commercial digital printing for all your marketing collateral.',
          icon: 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z',
          color: 'text-neon-pink',
          link: '/catalog'
        },
        { 
          title: 'Outdoor & Structural', 
          desc: 'Heavy-duty fabrication for massive highway hoardings, unipoles, and architectural ACP cladding for building facades.',
          icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
          color: 'text-neon-blue',
          link: '/catalog'
        },
        { 
          title: 'Custom Name Plates', 
          desc: 'Beautifully crafted residential and commercial name plates in brass, stainless steel, and edge-lit acrylic.',
          icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
          color: 'text-neon-pink',
          link: '/catalog'
        }
      ].map((service) => (
        <a href={service.link} class="bg-[var(--color-light-surface)] p-10 rounded-2xl border border-gray-200 hover:border-gray-300 transition-all group hover:-translate-y-1 block">
          <div class={`w-14 h-14 rounded-full bg-white flex items-center justify-center mb-6 border border-gray-200 group-hover:border-current ${service.color} transition-colors`}>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4 group-hover:text-neon-blue transition-all">{service.title}</h2>
          <p class="text-gray-600 leading-relaxed">{service.desc}</p>
        </a>
      ))}
    </div>
    
    <div class="mt-12 text-center">
      <a href="/catalog" class="inline-flex items-center justify-center px-8 py-4 font-bold rounded-lg bg-gray-900 text-white hover:bg-neon-pink transition-colors no-underline">
        View All 25+ Products in Catalog &rarr;
      </a>
    </div>

    {/* FAQ Section for AEO */}
    <div class="mt-24">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">Common Questions About Our Services</h2>
        <div class="h-1 w-20 bg-neon-pink mx-auto mt-4 box-glow"></div>
      </div>
      
      <div class="max-w-3xl mx-auto space-y-6">
        <details class="bg-white p-6 rounded-xl border border-gray-200 group" open>
          <summary class="text-lg font-bold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            What is the cost of a glow sign board in Chandigarh?
            <svg class="w-5 h-5 text-neon-pink group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-4 text-gray-600">The cost varies based on size, design complexity, and LED type. Classic Printing offers competitive pricing. Contact us at <a href="tel:7976169388" class="text-neon-blue font-semibold hover:underline">7976169388</a> for a free custom quote.</p>
        </details>
        <details class="bg-white p-6 rounded-xl border border-gray-200 group">
          <summary class="text-lg font-bold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            Do you provide 3D sign board installation in Mohali and Zirakpur?
            <svg class="w-5 h-5 text-neon-pink group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-4 text-gray-600">Yes! We provide end-to-end 3D sign board services including design, manufacturing, and professional installation across <strong>Mohali, Zirakpur, Panchkula, Kharar, Kurali</strong>, and all of Chandigarh.</p>
        </details>
        <details class="bg-white p-6 rounded-xl border border-gray-200 group">
          <summary class="text-lg font-bold text-gray-900 cursor-pointer list-none flex justify-between items-center">
            How long does flex printing take?
            <svg class="w-5 h-5 text-neon-pink group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <p class="mt-4 text-gray-600">Standard flex printing orders are typically completed within <strong>24-48 hours</strong>. For urgent requirements in the Tricity area, same-day delivery is available. Call <a href="tel:7976169388" class="text-neon-blue font-semibold hover:underline">7976169388</a> for rush orders.</p>
        </details>
      </div>
    </div>
  </div>
</Layout>
