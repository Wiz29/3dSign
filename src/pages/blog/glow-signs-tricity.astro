---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const articleSchema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "Glow Sign Boards: Illuminating Businesses across Chandigarh Tricity",
    "author": { "@type": "Organization", "name": "Classic Printing" },
    "publisher": { "@type": "Organization", "name": "Classic Printing" },
    "datePublished": "2026-07-10"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://3dsign.in/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://3dsign.in/blog" },
      { "@type": "ListItem", "position": 3, "name": "Glow Sign Boards: Illuminating Businesses across Chandigarh Tricity" }
    ]
  }
]);
---

<Layout 
  title="Glow Sign Boards: Illuminating Businesses across Chandigarh Tricity"
  description="Learn how neon and LED glow signs can dramatically increase your footfall in Chandigarh, Mohali, Panchkula, and Zirakpur. Call Classic Printing at 7976169388!"
  schema={articleSchema}
  canonicalPath="/blog/glow-signs-tricity"
>
  {/* Hero Section */}
  <section class="bg-[var(--color-light-surface)] pt-32 pb-20 border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 mb-6">
        Illuminating Businesses across <span class="text-neon-blue text-glow animate-flicker">Chandigarh Tricity</span>
      </h1>
      <p class="text-xl text-gray-600 mb-10">
        How custom LED and Neon Glow Signs can dramatically increase your nighttime footfall and brand recall.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <Button href="tel:7976169388" variant="blue-solid">Call Now: 7976169388</Button>
        <Button href="/contact" variant="secondary">Request a Quote</Button>
      </div>
    </div>
  </section>

  {/* Content */}
  <section class="py-20 max-w-4xl mx-auto px-4">
    <div class="prose prose-lg text-gray-600">
      <p>
        The <strong>Chandigarh Tricity area</strong>—encompassing Chandigarh, Mohali, and Panchkula—is known for its vibrant commercial sectors and bustling nightlife. If your business operates after dark, an unlit sign is essentially turning away customers.
      </p>
      <h2>The Power of LED Glow Signs</h2>
      <p>
        Glow sign boards act as a beacon for your business. Whether it's a restaurant in Sector 26, a clinic in Mohali Phase 7, or a boutique in Zirakpur, an LED-powered glow sign grabs attention from a distance, pulling in both vehicular and pedestrian traffic.
      </p>
      <h2>Energy Efficiency Meets Aesthetics</h2>
      <p>
        At Classic Printing, our modern glow boards use highly efficient LED modules that consume a fraction of the electricity used by older neon tubes, while providing much brighter and more consistent illumination. 
      </p>
      <p>
        We service the entire region, including Kharar and Kurali, providing end-to-end design, fabrication, and installation of glow signs. Contact us to light up your brand!
      </p>
    </div>
  </section>
</Layout>
