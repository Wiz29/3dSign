---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const catalogItems = [
  { title: 'Neon Glow Sign', image: '/images/glow_sign.png', category: 'Glow Signs' },
  { title: 'Corporate 3D Letters', image: '/images/3d_sign.png', category: '3D Signs' },
  { title: 'Outdoor Flex Banner', image: '/images/flex_sign.png', category: 'Flex Printing' },
  { title: 'Acrylic Office Board', image: '/images/acrylic_board.png', category: 'Acrylic Boards' },
];

const catalogSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Classic Printing - Sign Board Portfolio",
  "about": "Sign boards, 3D signs, glow signs, and flex printing projects across Chandigarh, Mohali, Panchkula, Zirakpur, Kharar, and Kurali",
  "image": catalogItems.map(item => ({
    "@type": "ImageObject",
    "name": item.title,
    "contentUrl": `https://3dsign.in${item.image}`
  }))
});
---

<Layout 
  title="Sign Board Portfolio & Gallery"
  description="Browse our portfolio of neon glow signs, corporate 3D letters, and flex banners installed across Chandigarh, Mohali, Zirakpur & Panchkula."
  schema={catalogSchema}
  canonicalPath="/catalog"
>
  <div class="pt-32 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 text-glow animate-flicker mb-4">Our Catalog</h1>
      <div class="h-1 w-24 bg-neon-blue mx-auto box-glow"></div>
      <p class="mt-6 text-xl text-gray-600 max-w-2xl mx-auto">
        Browse some of our latest premium installations and printing projects.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      {catalogItems.map((item) => (
        <div class="group relative rounded-xl overflow-hidden bg-[var(--color-light-surface)] border border-gray-200 hover:border-neon-blue transition-colors shadow-sm">
          <div class="aspect-w-16 aspect-h-10 w-full overflow-hidden">
            <img src={item.image} alt={item.title} class="w-full h-[400px] object-cover transform group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity"></div>
          <div class="absolute bottom-0 left-0 p-8 transform translate-y-4 group-hover:translate-y-0 transition-transform">
            <span class="text-neon-pink text-sm font-bold uppercase tracking-wider mb-2 block">{item.category}</span>
            <h3 class="text-2xl font-bold text-white">{item.title}</h3>
          </div>
        </div>
      ))}
    </div>
    
    <div class="mt-20 text-center bg-[var(--color-light-surface)] border border-gray-200 p-12 rounded-2xl shadow-sm">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Need a custom design?</h2>
      <p class="text-gray-600 mb-8 max-w-xl mx-auto">We can bring any concept to life. Share your ideas with us and we'll create the perfect signage for your brand.</p>
      <Button href="/contact" variant="primary">Request Custom Design</Button>
    </div>
  </div>
</Layout>
