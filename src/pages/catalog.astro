---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const catalogEntries = await getCollection('catalog');
// Sort by order, then by category
catalogEntries.sort((a, b) => a.data.order - b.data.order);

const catalogSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "Classic Printing - Sign Board Portfolio",
  "about": "Sign boards, 3D signs, glow signs, and flex printing projects across Chandigarh, Mohali, Panchkula, Zirakpur, Kharar, and Kurali",
  "image": catalogEntries.map(item => ({
    "@type": "ImageObject",
    "name": item.data.title,
    "contentUrl": `https://3dsign.in${item.data.image}`
  }))
});
---

<Layout 
  title="Sign Board Portfolio & Catalog | Classic Printing"
  description="Browse our complete catalog of 25+ signage solutions including 3D letters, glow signs, flex printing, and name plates across the Tricity."
  schema={catalogSchema}
  
>
  <div class="pt-32 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 text-glow animate-flicker mb-4">Our Complete Catalog</h1>
      <div class="h-1 w-24 bg-neon-blue mx-auto box-glow"></div>
      <p class="mt-6 text-xl text-gray-600 max-w-3xl mx-auto">
        From premium 3D letters for corporate offices to massive flex hoardings for highway advertising, explore our full range of manufacturing capabilities.
      </p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {catalogEntries.map((item) => (
        <a href={`/catalog/${item.id}`} class="group relative rounded-xl overflow-hidden bg-[var(--color-light-surface)] border border-gray-200 hover:border-neon-blue transition-colors shadow-sm block">
          <div class="aspect-w-16 aspect-h-10 w-full overflow-hidden">
            <img src={item.data.image} alt={item.data.title} class="w-full h-48 object-cover transform group-hover:scale-110 transition-transform duration-700" />
          </div>
          <div class="absolute top-0 right-0 p-4 z-10">
            <span class="bg-black/80 backdrop-blur text-neon-pink text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full">{item.data.category}</span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 group-hover:text-neon-blue transition-colors mb-2">{item.data.title}</h3>
            <p class="text-gray-600 text-sm line-clamp-2">{item.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    
    <div class="mt-20 text-center bg-[var(--color-light-surface)] border border-gray-200 p-12 rounded-2xl shadow-sm">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">Need a custom design?</h2>
      <p class="text-gray-600 mb-8 max-w-xl mx-auto">We can bring any concept to life. Share your ideas with us and we'll create the perfect signage for your brand.</p>
      <Button href="/contact" variant="primary">Request Custom Design</Button>
    </div>
  </div>
</Layout>
