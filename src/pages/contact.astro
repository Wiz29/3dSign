---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const localBusinessSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Classic Printing",
  "telephone": "+917976169388",
  "email": "rbishnoi.me@gmail.com",
  "url": "https://3dsign.in",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Chandigarh",
    "addressRegion": "Chandigarh",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 30.7333,
    "longitude": 76.7794
  },
  "areaServed": [
    { "@type": "City", "name": "Chandigarh" },
    { "@type": "City", "name": "Mohali" },
    { "@type": "City", "name": "Kharar" },
    { "@type": "City", "name": "Kurali" },
    { "@type": "City", "name": "Zirakpur" },
    { "@type": "City", "name": "Panchkula" }
  ],
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
    "opens": "09:00",
    "closes": "19:00"
  }
});
---

<Layout 
  title="Contact Us - Get a Free Sign Board Quote"
  description="Contact Classic Printing for a free sign board, 3D sign, or flex printing quote in Chandigarh, Mohali, Zirakpur, Panchkula, Kharar & Kurali. Call 7976169388!"
  schema={localBusinessSchema}
  
>
  <div class="pt-32 pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 text-glow animate-flicker mb-4">Contact Us</h1>
      <div class="h-1 w-24 bg-neon-blue mx-auto box-glow"></div>
      <p class="mt-6 text-xl text-gray-600 max-w-2xl mx-auto">
        Ready to make your business shine? Get in touch with us today.
      </p>
    </div>
    
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {/* Contact Info */}
      <div class="bg-[var(--color-light-surface)] p-10 rounded-2xl border border-gray-200 shadow-sm">
        <h2 class="text-3xl font-bold text-gray-900 mb-8">Get In Touch</h2>
        
        <div class="space-y-8">
          <div class="flex items-start">
            <div class="w-12 h-12 rounded-full bg-white border border-neon-pink text-neon-pink flex items-center justify-center flex-shrink-0 mt-1 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            </div>
            <div class="ml-6">
              <h3 class="text-xl font-bold text-gray-900 mb-1">Phone</h3>
              <p class="text-gray-600 text-lg"><a href="tel:7976169388" class="hover:text-neon-pink transition-colors">+91 7976169388</a></p>
            </div>
          </div>
          
          <div class="flex items-start">
            <div class="w-12 h-12 rounded-full bg-white border border-neon-blue text-neon-blue flex items-center justify-center flex-shrink-0 mt-1 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
            </div>
            <div class="ml-6">
              <h3 class="text-xl font-bold text-gray-900 mb-1">WhatsApp</h3>
              <p class="text-gray-600 text-lg"><a href="https://wa.me/917976169388" class="hover:text-neon-blue transition-colors">7976169388</a></p>
            </div>
          </div>
          
          <div class="flex items-start">
            <div class="w-12 h-12 rounded-full bg-white border border-gray-300 text-gray-600 flex items-center justify-center flex-shrink-0 mt-1 shadow-sm">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="ml-6">
              <h3 class="text-xl font-bold text-gray-900 mb-1">Email</h3>
              <p class="text-gray-600 text-lg"><a href="mailto:rbishnoi.me@gmail.com" class="hover:text-gray-900 transition-colors">rbishnoi.me@gmail.com</a></p>
            </div>
          </div>
        </div>
      </div>
      
      {/* Quick Connect Actions */}
      <div class="bg-[var(--color-light-surface)] p-10 rounded-2xl border border-gray-200 shadow-sm relative overflow-hidden flex flex-col justify-center items-center text-center">
        {/* Subtle decorative glow */}
        <div class="absolute top-0 right-0 w-64 h-64 bg-neon-pink/5 rounded-full blur-[80px] -z-10 pointer-events-none"></div>
        
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Fastest Way to Connect</h2>
        <p class="text-gray-600 mb-8 max-w-sm">Skip the wait. Call us or send a quick message on WhatsApp for immediate support.</p>
        
        <div class="space-y-4 w-full max-w-sm">
          <Button href="tel:7976169388" variant="blue-solid" class="w-full text-lg py-4">Call: 7976169388</Button>
          <Button href="https://wa.me/917976169388" variant="primary" class="w-full text-lg py-4 bg-green-500 hover:bg-green-600 border-green-500 hover:border-green-600 shadow-[0_0_15px_rgba(34,197,94,0.3)] hover:text-white text-white">WhatsApp Us</Button>
          <Button href="mailto:rbishnoi.me@gmail.com" variant="secondary" class="w-full text-lg py-4 border-gray-400 text-gray-600 hover:bg-gray-100 hover:text-gray-900 hover:border-gray-400 shadow-none text-shadow-none">Send an Email</Button>
        </div>
      </div>
    </div>
  </div>
</Layout>
